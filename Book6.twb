  <worksheets>
    <worksheet name='Sheet 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Year-wise Sales Trend Analysis</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#aa0000' fontname='Benton Sans Book' fontsize='8' lmargin='600' rmargin='600'>Sales increased steadily from 2020 to 2022, reaching peak performance in 2022. A gradual decline followed in subsequent years, with a significant drop observed in 2025. </run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Dataset (retail)' name='federated.14zsifn14cv2ew11db3se05wg1hx' />
          </datasources>
