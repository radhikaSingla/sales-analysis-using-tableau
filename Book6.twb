          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Quarter-wise Sales Distribution Analysis</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#aa0000' fontname='Benton Sans Book' fontsize='8' lmargin='600' rmargin='600'>Quarterly analysis shows that Q4 contributed the highest sales across most years, highlighting stronger end-of-year sales performance. </run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Dataset (retail)' name='federated.14zsifn14cv2ew11db3se05wg1hx' />
