      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffbe7d'>Discrete line chart</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>This line chart shows the yearly sales trend from 2020 to 2025. Sales increased steadily until 2022, followed by a slight decline, with a sharp drop in 2025 .</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
